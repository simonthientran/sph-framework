{
  "meta": {
    "name": "Benchmark: 3D Periodic Cylindrical Pipe (Hagen-Poiseuille)",
    "version": 1,
    "dimensions": 3,
    "description": "Body-force-driven flow in a round-cross-section pipe, periodic in x. Cylinder axis along x, center (y=0.14, z=0.14), radius R=0.10, spacing 0.01. Analytical: u(r)=f/(4*nu)*(R^2-r^2), u_max=f*R^2/(4*nu). With f=0.003, nu=0.12, R=0.10: u_max=6.25e-5 m/s (Stokes, Re<<1). Mirrors the proven benchmark_pipe_flow_3d.json calibration (nu in scene == nu in analytical, default viscosity_factor). Center 0.14 keeps all coords positive.",
    "scene_type": "periodic_pipe"
  },

  "fluids": [
    {
      "type": "cylinder_x",
      "name": "fluid",
      "spacing": 0.01,
      "axis_min": 0.0,
      "axis_max": 0.06,
      "center": [0.14, 0.14],
      "radius": 0.10,
      "initial_velocity": [0.0, 0.0, 0.0]
    }
  ],

  "domain": {
    "min": [0.0, 0.0, 0.0],
    "max": [0.06, 0.28, 0.28],
    "periodic_x": true,
    "cylinder_wall": {
      "center": [0.14, 0.14],
      "radius": 0.10,
      "boundary_layers": 2
    }
  },

  "material": {
    "rho0": 1000.0,
    "eos": {
      "type": "linear",
      "k": 50000.0
    }
  },

  "solver": {
    "type": "dfsph",
    "eos_k": 50000.0,
    "dfsph": {
      "viscosity_factor": 2.0,
      "eta_cd": 0.01,
      "eta_df": 0.1,
      "max_iter_cd": 100,
      "max_iter_df": 100,
      "density_diffusion": {
        "enable": false,
        "delta": 0.1,
        "floor_ratio": 0.60
      },
      "free_surface_stabilization": {
        "enable": false
      }
    }
  },

  "forces": {
    "gravity": [0.003, 0.0, 0.0],
    "viscosity": {
      "enable": true,
      "nu": 0.12
    },
    "xsph": {
      "enable": false
    }
  },

  "neighbors": {
    "type": "kdtree",
    "support_radius": 0.02
  },

  "time": {
    "mode": "cfl",
    "cfl": 0.4,
    "dt_min": 1.0e-6,
    "dt_max": 0.0002,
    "steps": 3500
  },

  "export": {
    "csv": { "enable": false },
    "vtk": { "enable": false }
  }
}
