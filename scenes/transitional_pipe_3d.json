{
  "meta": {
    "name": "Higher-Re Pipe Flow (body-force-driven, nu=0.0001)",
    "version": 1,
    "dimensions": 3,
    "description": "Body-force-driven Hagen-Poiseuille flow in a circular pipe. Periodic in x. R=0.10, center=(0.14,0.14), f=0.003, nu=0.0001. Analytical: vmax=f*R^2/(4*nu)=0.75 m/s, vmean~0.375, Re=vmean*0.20/0.0001~750 (laminar, higher Re than laminar_pipe_3d). Note: true turbulence (Re>2300) not achievable at this SPH resolution without turbulence models.",
    "scene_type": "periodic_pipe"
  },

  "hydraulic_diameter": 0.20,

  "physics_target": {
    "Re_expected": 750.0,
    "regime": "laminar",
    "expected_profile": "parabolic",
    "L2_threshold": 0.15,
    "note": "Higher-Re laminar flow; SPH accuracy lower at this Re. True turbulence not achievable without turbulence models."
  },

  "fluids": [
    {
      "type": "cylinder_x",
      "name": "fluid",
      "spacing": 0.01,
      "axis_min": 0.0,
      "axis_max": 0.06,
      "center": [0.14, 0.14],
      "radius": 0.10,
      "initial_velocity": [0.0, 0.0, 0.0]
    }
  ],

  "domain": {
    "min": [0.0, 0.0, 0.0],
    "max": [0.06, 0.28, 0.28],
    "periodic_x": true,
    "cylinder_wall": {
      "center": [0.14, 0.14],
      "radius": 0.10,
      "boundary_layers": 2
    }
  },

  "material": {
    "rho0": 1000.0,
    "eos": {
      "type": "linear",
      "k": 50000.0
    }
  },

  "solver": {
    "type": "dfsph",
    "eos_k": 50000.0,
    "dfsph": {
      "viscosity_factor": 2.0,
      "eta_cd": 0.01,
      "eta_df": 0.1,
      "max_iter_cd": 100,
      "max_iter_df": 100,
      "density_diffusion": {
        "enable": false,
        "delta": 0.1,
        "floor_ratio": 0.60
      },
      "free_surface_stabilization": {
        "enable": false
      }
    }
  },

  "forces": {
    "gravity": [0.003, 0.0, 0.0],
    "viscosity": {
      "enable": true,
      "nu": 0.0001
    },
    "xsph": {
      "enable": false
    }
  },

  "neighbors": {
    "type": "kdtree",
    "support_radius": 0.02
  },

  "time": {
    "mode": "cfl",
    "cfl": 0.4,
    "dt_min": 1.0e-6,
    "dt_max": 0.0002,
    "steps": 3000
  },

  "export": {
    "csv": { "enable": false },
    "vtk": { "enable": false }
  }
}
