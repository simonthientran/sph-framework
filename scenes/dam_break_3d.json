{
  "meta": {
    "name": "3D Dam Break",
    "version": 1,
    "dimensions": 3,
    "description": "Classic 3D dam break: fluid column [0.02-0.35 x 0.02-0.50 x 0.02-0.38] released in a 1.0x0.6x0.4 open-top container. particleRadius=0.025, nu=0.001, gravity -9.81.",
    "scene_type": "free_surface"
  },

  "fluids": [
    {
      "type": "box",
      "name": "dam_column",
      "spacing": 0.025,
      "min": [0.02, 0.02, 0.02],
      "max": [0.35, 0.50, 0.38],
      "initial_velocity": [0.0, 0.0, 0.0]
    }
  ],

  "domain": {
    "min": [0.0, 0.0, 0.0],
    "max": [1.0, 0.6, 0.4],
    "box_container": {
      "open_top": true,
      "boundary_layers": 2
    }
  },

  "material": {
    "rho0": 1000.0,
    "eos": {
      "type": "linear",
      "k": 50000.0
    }
  },

  "solver": {
    "type": "dfsph",
    "eos_k": 50000.0,
    "dfsph": {
      "eta_cd": 0.05,
      "eta_df": 0.1,
      "max_iter_cd": 50,
      "max_iter_df": 50,
      "density_diffusion": {
        "enable": true,
        "delta": 0.1,
        "floor_ratio": 0.60
      },
      "free_surface_stabilization": {
        "enable": true,
        "mode": "density_shift",
        "strength": 0.4,
        "target_ratio": 0.88,
        "max_raise_ratio": 0.12
      }
    }
  },

  "forces": {
    "gravity": [0.0, -9.81, 0.0],
    "viscosity": {
      "enable": true,
      "nu": 0.001
    },
    "xsph": {
      "enable": false
    }
  },

  "neighbors": {
    "type": "kdtree",
    "support_radius": 0.1
  },

  "time": {
    "mode": "cfl",
    "cfl": 0.4,
    "dt_min": 1.0e-5,
    "dt_max": 0.001,
    "steps": 1500
  },

  "export": {
    "csv": { "enable": false },
    "vtk": {
      "enable": true,
      "every": 50,
      "dir": "out/dam_break_3d"
    }
  }
}
