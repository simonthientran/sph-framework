{
  "meta": {
    "name": "3D Cylindrical Pipe Flow (Hagen-Poiseuille)",
    "version": 1,
    "dimensions": 3,
    "scene_type": "periodic_pipe"
  },

  "fluids": [
    {
      "type": "cylinder",
      "name": "fluid",
      "spacing": 0.01,
      "min": [0.05, -0.085, -0.085],
      "max": [0.45, 0.085, 0.085],
      "axis_center": [0.0, 0.0],
      "radius": 0.085,
      "initial_velocity": [0.0, 0.0, 0.0]
    }
  ],

  "domain": {
    "min": [0.00, -0.14, -0.14],
    "max": [0.50, 0.14, 0.14],
    "periodic_x": true
  },

  "boundaries": [
    {
      "type": "stl",
      "file": "../assets/cylinder_pipe.stl",
      "sampling": "poisson",
      "n_layers": 3
    }
  ],

  "material": {
    "rho0": 1000.0
  },

  "solver": {
    "type": "dfsph",
    "eos_k": 50000.0,
    "dfsph": {
      "eta_cd": 0.01,
      "eta_df": 0.1,
      "max_iter_cd": 100,
      "max_iter_df": 100,
      "density_diffusion": { "enable": true, "delta": 0.1 },
      "free_surface_stabilization": { "enable": false }
    }
  },

  "forces": {
    "gravity": [0.0003, 0.0, 0.0],
    "viscosity": { "enable": true, "nu": 0.01 },
    "xsph": { "enable": false }
  },

  "neighbors": {
    "type": "kdtree",
    "support_radius": 0.03
  },

  "time": {
    "mode": "cfl",
    "cfl": 0.4,
    "dt_min": 1.0e-6,
    "dt_max": 0.002,
    "steps": 5000
  },

  "export": {
    "csv": { "enable": false },
    "vtk": { "enable": false }
  }
}
