{
  "meta": {
    "name": "3D Cylinder Pipe Flow (inlet-driven, water)",
    "version": 2,
    "dimensions": 3,
    "description": "Inlet-driven pipe flow: nu=0.001 (water), inlet_velocity=0.5 m/s, no body force. Open domain (periodic_x disabled). Outlet removes at x>0.95, inlet injects fresh layer at x=0.01. Pipe length 1.0 m.",
    "scene_type": "cylinder_pipe"
  },

  "fluids": [
    {
      "type": "cylinder_x",
      "name": "fluid",
      "spacing": 0.02,
      "axis_min": 0.0,
      "axis_max": 0.95,
      "center": [0.1, 0.1],
      "radius": 0.07,
      "initial_velocity": [0.1, 0.0, 0.0]
    }
  ],

  "domain": {
    "min": [0.0, 0.0, 0.0],
    "max": [1.0, 0.2, 0.2],
    "periodic_x": false,
    "cylinder_wall": {
      "center": [0.1, 0.1],
      "radius": 0.07,
      "boundary_layers": 2
    },
    "inlet_outlet": {
      "enable": true,
      "outlet_x": 0.95,
      "inlet_x": 0.01,
      "inlet_velocity": 0.1,
      "outlet_pressure": 100000.0
    }
  },

  "material": {
    "rho0": 1000.0,
    "eos": {
      "type": "linear",
      "k": 50000.0
    }
  },

  "solver": {
    "type": "dfsph",
    "eos_k": 50000.0,
    "dfsph": {
      "viscosity_factor": 2.0,
      "eta_cd": 0.01,
      "eta_df": 0.1,
      "max_iter_cd": 100,
      "max_iter_df": 100,
      "density_diffusion": {
        "enable": false,
        "delta": 0.1,
        "floor_ratio": 0.60
      },
      "free_surface_stabilization": {
        "enable": false
      }
    }
  },

  "forces": {
    "gravity": [0.0, 0.0, 0.0],
    "viscosity": {
      "enable": true,
      "nu": 0.001
    },
    "xsph": {
      "enable": false
    }
  },

  "neighbors": {
    "type": "kdtree",
    "support_radius": 0.04
  },

  "time": {
    "mode": "cfl",
    "cfl": 0.4,
    "dt_min": 1.0e-6,
    "dt_max": 0.0002,
    "steps": 500
  },

  "export": {
    "csv": { "enable": false },
    "vtk": { "enable": true, "every": 10, "dir": "out/cylinder" }
  }
}
