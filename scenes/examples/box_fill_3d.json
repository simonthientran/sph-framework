{
  "meta": {
    "name": "box_fill_3d",
    "version": 1,
    "dimensions": 3,
    "description": "3D box container loaded from STL with fluid block inside. Gravity in -y. Used to validate STL boundary import pipeline."
  },
  "fluid": {
    "type": "block",
    "min": [
      0.1,
      0.1,
      0.1
    ],
    "max": [
      0.9,
      0.6,
      0.9
    ],
    "spacing": 0.05,
    "initial_velocity": [
      0.0,
      0.0,
      0.0
    ]
  },
  "boundaries": [
    {
      "type": "stl",
      "file": "../../assets/box.stl",
      "sampling": "poisson",
      "n_layers": 3
    }
  ],
  "neighbors": {
    "type": "kdtree",
    "support_radius": 0.13
  },
  "material": {
    "rho0": 1000.0,
    "eos": {
      "type": "linear",
      "k": 5000.0
    },
    "viscosity": {
      "enable": true,
      "nu": 0.01
    }
  },
  "solver": {
    "type": "dfsph",
    "eos_k": 5000.0,
    "eta_cd": 0.012,
    "density_diffusion": {
      "enable": false,
      "delta": 0.0
    },
    "free_surface_stabilization": {
      "enable": false
    }
  },
  "forces": {
    "gravity": [
      0.0,
      -9.81,
      0.0
    ],
    "viscosity": {
      "enable": true,
      "nu": 0.01
    },
    "xsph": {
      "enable": false
    }
  },
  "time": {
    "mode": "cfl",
    "cfl": 0.25,
    "dt_min": 1e-06,
    "dt_max": 0.0005,
    "steps": 100
  },
  "export": {
    "csv": {
      "enable": false
    },
    "vtk": {
      "enable": false
    }
  }
}
