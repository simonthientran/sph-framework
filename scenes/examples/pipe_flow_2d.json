{
  "meta": {
    "name": "pipe_flow_2d",
    "version": 2,
    "dimensions": 2,
    "authors": ["SPH Framework Team"],
    "description": "Periodic-like 2D internal single-phase flow used for velocity-profile validation."
  },

  "domain": {
    "type": "box",
    "min": [0.0, 0.0],
    "max": [1.0, 0.2],
    "boundary_layers": 3
  },

  "fluid": {
    "type": "block",
    "min": [0.0, 0.03],
    "max": [1.0, 0.17],
    "spacing": 0.008,
    "initial_velocity": [0.0, 0.0]
  },

  "neighbors": {
    "type": "spatial_hash",
    "support_radius": 0.0208
  },

  "material": {
    "rho0": 1000.0,
    "eos": {
      "type": "linear",
      "k": 8000.0
    }
  },

  "solver": {
    "type": "dfsph",
    "eos_k": 8000.0,
    "pressure_clamp_min": 0.0,
    "density_diffusion": {
      "enable": true,
      "alpha": 0.25
    }
  },

  "forces": {
    "gravity": [0.003, 0.0],
    "viscosity": {
      "enable": true,
      "nu": 0.12
    },
    "xsph": {
      "enable": true,
      "eps": 0.05
    }
  },

  "time": {
    "mode": "cfl",
    "cfl": 0.18,
    "dt_min": 2e-06,
    "dt_max": 1.0e-04,
    "dt_fixed": 1.0e-04,
    "steps": 1200,
    "log_every": 20
  },

  "export": {
    "csv": {
      "enable": false,
      "every": 100,
      "dir": "out/csv"
    },
    "vtk": {
      "enable": false,
      "every": 100,
      "dir": "out/vtk"
    }
  }
}
