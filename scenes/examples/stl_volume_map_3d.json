{
  "meta": {
    "name": "stl_volume_map_3d",
    "version": 1,
    "dimensions": 3,
    "description": "3D STL container using Bender 2019 volume-map boundary representation alongside particle boundaries.",
    "scene_type": "free_surface"
  },
  "fluids": [
    {
      "type": "box",
      "name": "container_fill",
      "spacing": 0.05,
      "min": [0.2, 0.05, 0.2],
      "max": [0.5, 0.7, 0.8],
      "initial_velocity": [0.0, 0.0, 0.0]
    }
  ],
  "boundaries": [
    {
      "type": "stl",
      "file": "../../assets/box.stl",
      "sampling": "poisson",
      "n_layers": 3,
      "representations": ["particles", "sdf", "volume_map"],
      "boundary_handling_method": "volume_map",
      "sdf": {
        "enable": true,
        "runtime_wall_guard": {
          "enable": true,
          "min_gap": 0.0125,
          "target_gap": 0.025,
          "max_shift": 0.025,
          "project_outward_velocity": true
        }
      }
    }
  ],
  "neighbors": {
    "type": "kdtree",
    "support_radius": 0.13
  },
  "materials": [
    {
      "id": "Fluid",
      "density0": 1000.0,
      "viscosity": 0.01,
      "xsph": 0.0,
      "colorField": "velocity",
      "colorMapType": "jet",
      "renderMinValue": 0.0,
      "renderMaxValue": 3.0
    }
  ],
  "material": {
    "rho0": 1000.0,
    "eos": {
      "type": "linear",
      "k": 5000.0
    }
  },
  "solver": {
    "type": "dfsph",
    "eos_k": 5000.0,
    "dfsph": {
      "eta_cd": 0.012,
      "density_diffusion": { "enable": false, "delta": 0.0 },
      "free_surface_stabilization": { "enable": false }
    }
  },
  "forces": {
    "gravity": [0.0, -9.81, 0.0],
    "viscosity": { "enable": true, "nu": 0.01 },
    "xsph": { "enable": false }
  },
  "time": {
    "mode": "cfl",
    "cfl": 0.25,
    "dt_min": 1e-06,
    "dt_max": 0.002,
    "steps": 200
  },
  "export": {
    "csv": { "enable": false },
    "vtk": { "enable": false }
  }
}
