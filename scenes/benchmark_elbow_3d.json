{
  "meta": {
    "name": "Benchmark: 3D Elbow Pipe",
    "version": 1,
    "dimensions": 3,
    "description": "3D L-shaped elbow pipe with gravity-driven flow. Fluid enters vertical section, turns horizontal. Tests boundary handling at curved geometry and junction.",
    "scene_type": "free_surface"
  },

  "fluids": [
    {
      "type": "box",
      "name": "fluid",
      "spacing": 0.03,
      "min": [0.02, 0.05, 0.02],
      "max": [0.18, 0.45, 0.18],
      "initial_velocity": [0.0, 0.0, 0.0]
    }
  ],

  "boundaries": [
    {
      "type": "stl",
      "file": "../assets/elbow.stl",
      "sampling": "poisson",
      "n_layers": 3
    }
  ],

  "material": {
    "rho0": 1000.0,
    "eos": {
      "type": "linear",
      "k": 5000.0
    }
  },

  "solver": {
    "type": "dfsph",
    "eos_k": 5000.0,
    "dfsph": {
      "eta_cd": 0.05,
      "max_iter_cd": 50,
      "density_diffusion": {
        "enable": true,
        "delta": 0.1,
        "floor_ratio": 0.60
      },
      "free_surface_stabilization": {
        "enable": true,
        "mode": "density_shift",
        "strength": 0.4,
        "target_ratio": 0.88,
        "max_raise_ratio": 0.12
      }
    }
  },

  "forces": {
    "gravity": [0.0, -9.81, 0.0],
    "viscosity": {
      "enable": true,
      "nu": 0.001
    }
  },

  "neighbors": {
    "type": "kdtree",
    "support_radius": 0.09
  },

  "time": {
    "mode": "cfl",
    "cfl": 0.4,
    "dt_min": 1.0e-5,
    "dt_max": 0.001,
    "steps": 1000
  },

  "export": {
    "csv": { "enable": false },
    "vtk": { "enable": false }
  }
}
