{
  "meta": {
    "name": "3D Elbow Pipe Flow (body-force-driven)",
    "version": 1,
    "dimensions": 3,
    "description": "Body-force-driven elbow pipe flow. STL geometry: assets/pipes/elbow_pipe.stl (two cylinders joined at 90 deg via boolean union, R=0.05, each 0.4m long). After transform (rotate 90deg around Y, translate [0.2,0.175,0]): horizontal section along x [0,0.4], vertical section along y [0,0.4] at x=0.2. Fluid in horizontal segment interior. Body force [0.003,0,0]. No periodic_x.",
    "scene_type": "pipe_elbow"
  },

  "fluid": {
    "type": "box",
    "spacing": 0.02,
    "min": [0.02, 0.135, -0.04],
    "max": [0.38, 0.215, 0.04],
    "initial_velocity": [0.0, 0.0, 0.0]
  },

  "domain": {
    "min": [-0.04, -0.09, -0.09],
    "max": [0.45, 0.45, 0.09]
  },

  "material": {
    "rho0": 1000.0,
    "eos": {
      "type": "linear",
      "k": 50000.0
    }
  },

  "solver": {
    "type": "dfsph",
    "eos_k": 50000.0,
    "density_diffusion": {
      "enable": true,
      "delta": 0.1,
      "floor_ratio": 0.97
    },
    "dfsph": {
      "viscosity_factor": 2.0,
      "eta_cd": 0.01,
      "eta_df": 0.1,
      "max_iter_cd": 100,
      "max_iter_df": 100,
      "free_surface_stabilization": {
        "enable": false
      }
    }
  },

  "forces": {
    "gravity": [0.003, 0.0, 0.0],
    "viscosity": {
      "enable": true,
      "nu": 0.12
    },
    "xsph": {
      "enable": false
    }
  },

  "neighbors": {
    "type": "kdtree",
    "support_radius": 0.04
  },

  "time": {
    "mode": "cfl",
    "cfl": 0.4,
    "dt_min": 1.0e-6,
    "dt_max": 0.0002,
    "steps": 500
  },

  "boundaries": [
    {
      "type": "stl",
      "file": "../assets/pipes/elbow_pipe.stl",
      "sampling": "regular",
      "n_layers": 5,
      "rotation_axis": [0, 1, 0],
      "rotation_angle": 90,
      "translation": [0.2, 0.175, 0.0]
    }
  ],

  "export": {
    "csv": { "enable": false },
    "vtk": { "enable": false }
  }
}
