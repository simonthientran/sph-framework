{
  "meta": {
    "name": "3D Elbow Pipe Flow (native z-long STL)",
    "version": 1,
    "dimensions": 3,
    "description": "Elbow STL as-is: horizontal arm along z [-0.2,0.2], vertical arm along y [-0.05,0.40], inner R~0.05. Body force +z.",
    "scene_type": "pipe_elbow"
  },

  "fluids": [
    {
      "spacing": 0.02,
      "initial_velocity": [0.0, 0.0, 0.0],
      "sources": [
        {
          "type": "cylinder_z",
          "center": [0.0, 0.0, 0.0],
          "radius": 0.038,
          "height": 0.32
        }
      ]
    }
  ],

  "domain": {
    "min": [-0.08, -0.08, -0.25],
    "max": [0.08, 0.50, 0.25]
  },

  "material": {
    "rho0": 1000.0,
    "eos": {
      "type": "linear",
      "k": 50000.0
    }
  },

  "solver": {
    "type": "dfsph",
    "eos_k": 50000.0,
    "density_diffusion": {
      "enable": true,
      "delta": 0.1,
      "floor_ratio": 0.97
    },
    "dfsph": {
      "viscosity_factor": 2.0,
      "eta_cd": 0.05,
      "eta_df": 0.1,
      "max_iter_cd": 10,
      "max_iter_df": 100,
      "free_surface_stabilization": {
        "enable": false
      }
    }
  },

  "forces": {
    "gravity": [0.0, 0.0, 0.003],
    "viscosity": {
      "enable": true,
      "nu": 0.12
    },
    "xsph": {
      "enable": false
    }
  },

  "neighbors": {
    "type": "kdtree",
    "support_radius": 0.04
  },

  "time": {
    "mode": "cfl",
    "cfl": 0.4,
    "dt_min": 1.0e-6,
    "dt_max": 0.0002,
    "steps": 500
  },

  "boundaries": [
    {
      "type": "stl",
      "file": "../assets/pipes/elbow_pipe.stl",
      "sampling": "regular",
      "n_layers": 3,
      "rotation_angle": 0,
      "translation": [0.0, 0.0, 0.0]
    }
  ],

  "export": {
    "csv": { "enable": false },
    "vtk": { "enable": false }
  }
}
