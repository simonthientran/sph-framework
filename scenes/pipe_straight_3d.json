{
  "meta": {
    "name": "3D Straight Pipe Flow (body-force-driven Poiseuille)",
    "version": 1,
    "dimensions": 3,
    "description": "Body-force-driven straight pipe flow. Periodic in x, cylindrical pipe of radius 0.07 centered at (0.1, 0.1) in the y-z plane, length 1.0 m. f=0.003 m/s^2 in x, nu=0.12 (matching the validated cylinder/Poiseuille setup). Hagen-Poiseuille analytical: vmax = f*R^2/(4*nu) = 0.003*0.07^2/(4*0.12) ~ 3.06e-5 m/s, laminar Re<<1. Loader uses the cylinder_x fluid + cylinder_wall domain block (STL rigid bodies are not supported by simulator_new.py). STL asset assets/pipes/straight_pipe.stl mirrors this geometry for visualization.",
    "scene_type": "periodic_pipe"
  },

  "fluids": [
    {
      "type": "cylinder_x",
      "name": "fluid",
      "spacing": 0.02,
      "axis_min": 0.0,
      "axis_max": 1.0,
      "center": [0.1, 0.1],
      "radius": 0.07,
      "initial_velocity": [0.0, 0.0, 0.0]
    }
  ],

  "domain": {
    "min": [0.0, 0.0, 0.0],
    "max": [1.0, 0.2, 0.2],
    "periodic_x": true,
    "cylinder_wall": {
      "center": [0.1, 0.1],
      "radius": 0.07,
      "boundary_layers": 2
    }
  },

  "material": {
    "rho0": 1000.0,
    "eos": {
      "type": "linear",
      "k": 50000.0
    }
  },

  "solver": {
    "type": "dfsph",
    "eos_k": 50000.0,
    "dfsph": {
      "viscosity_factor": 2.0,
      "eta_cd": 0.01,
      "eta_df": 0.1,
      "max_iter_cd": 100,
      "max_iter_df": 100,
      "density_diffusion": {
        "enable": false,
        "delta": 0.1,
        "floor_ratio": 0.60
      },
      "free_surface_stabilization": {
        "enable": false
      }
    }
  },

  "forces": {
    "gravity": [0.003, 0.0, 0.0],
    "viscosity": {
      "enable": true,
      "nu": 0.12
    },
    "xsph": {
      "enable": false
    }
  },

  "neighbors": {
    "type": "kdtree",
    "support_radius": 0.04
  },

  "time": {
    "mode": "cfl",
    "cfl": 0.4,
    "dt_min": 1.0e-6,
    "dt_max": 0.0002,
    "steps": 500
  },

  "export": {
    "csv": { "enable": false },
    "vtk": { "enable": false }
  }
}
