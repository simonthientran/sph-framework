{
  "meta": {
    "name": "Industrial Pipe Benchmark (Hagen-Poiseuille, nu=0.01)",
    "version": 1,
    "dimensions": 3,
    "description": "Body-force-driven Poiseuille flow in a cylindrical pipe, periodic in x. R=0.095 m, L=1.0 m, nu=0.01 m²/s. Analytical: u(r)=f/(4*nu)*(R²-r²), u_max=f*R²/(4*nu). With f=0.001, nu=0.01, R=0.095: u_max=f*R²/(4*nu)=0.001*0.009025/0.04≈2.256e-4 m/s. Re=vmean*D/nu≈0.002 (Stokes). Center (0.1,0.1) keeps all coords positive.",
    "scene_type": "periodic_pipe"
  },

  "hydraulic_diameter": 0.19,

  "physics_target": {
    "vmax_analytical": 2.256e-4,
    "vmean_analytical": 1.128e-4,
    "reynolds_number": 0.002,
    "regime": "LAMINAR",
    "body_force": 0.001,
    "radius": 0.095,
    "nu": 0.01
  },

  "fluids": [
    {
      "type": "cylinder_x",
      "name": "fluid",
      "spacing": 0.01,
      "axis_min": 0.0,
      "axis_max": 0.05,
      "center": [0.12, 0.12],
      "radius": 0.095,
      "initial_velocity": [0.0, 0.0, 0.0]
    }
  ],

  "domain": {
    "min": [0.0, 0.0, 0.0],
    "max": [0.05, 0.25, 0.25],
    "periodic_x": true,
    "cylinder_wall": {
      "center": [0.12, 0.12],
      "radius": 0.095,
      "boundary_layers": 2
    }
  },

  "material": {
    "rho0": 1000.0,
    "eos": {
      "type": "linear",
      "k": 50000.0
    }
  },

  "solver": {
    "type": "dfsph",
    "eos_k": 50000.0,
    "dfsph": {
      "viscosity_factor": 2.0,
      "eta_cd": 0.01,
      "eta_df": 0.1,
      "max_iter_cd": 100,
      "max_iter_df": 100,
      "density_diffusion": {
        "enable": false,
        "delta": 0.1
      },
      "free_surface_stabilization": {
        "enable": false
      }
    }
  },

  "forces": {
    "gravity": [0.001, 0.0, 0.0],
    "viscosity": {
      "enable": true,
      "nu": 0.01
    },
    "xsph": {
      "enable": false
    }
  },

  "neighbors": {
    "type": "kdtree",
    "support_radius": 0.02
  },

  "time": {
    "mode": "cfl",
    "cfl": 0.4,
    "dt_min": 1.0e-6,
    "dt_max": 0.001,
    "steps": 8000
  },

  "export": {
    "csv": { "enable": false },
    "vtk": { "enable": false }
  }
}
