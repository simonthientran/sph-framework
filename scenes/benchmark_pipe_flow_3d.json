{
  "meta": {
    "name": "Benchmark: 3D Periodic Pipe Flow (Poiseuille)",
    "version": 1,
    "dimensions": 3,
    "description": "3D fully periodic Poiseuille flow driven by body force in x. Analytical solution: vx = f*L^2/(2*nu)*(1-(r/L)^2). With f=0.003, nu=0.12, L=0.06: vmax=4.5e-5 m/s. Laminar Re<<1. Note: fluid max is exclusive (arange), so max=[0.2,0.18,0.18] places last particle at y=z=0.16.",
    "scene_type": "periodic_pipe"
  },

  "fluids": [
    {
      "type": "box",
      "name": "fluid",
      "spacing": 0.02,
      "min": [0.0, 0.04, 0.04],
      "max": [0.2, 0.18, 0.18],
      "initial_velocity": [0.0, 0.0, 0.0]
    }
  ],

  "domain": {
    "min": [0.0, 0.0, 0.0],
    "max": [0.2, 0.2, 0.2],
    "periodic_x": true,
    "boundary_layers": 2
  },

  "material": {
    "rho0": 1000.0,
    "eos": {
      "type": "linear",
      "k": 50000.0
    }
  },

  "solver": {
    "type": "dfsph",
    "eos_k": 50000.0,
    "dfsph": {
      "eta_cd": 0.01,
      "eta_df": 0.1,
      "max_iter_cd": 100,
      "max_iter_df": 100,
      "density_diffusion": {
        "enable": false,
        "delta": 0.1,
        "floor_ratio": 0.60
      },
      "free_surface_stabilization": {
        "enable": false
      }
    }
  },

  "forces": {
    "gravity": [0.003, 0.0, 0.0],
    "viscosity": {
      "enable": true,
      "nu": 0.12
    },
    "xsph": {
      "enable": false
    }
  },

  "neighbors": {
    "type": "kdtree",
    "support_radius": 0.04
  },

  "time": {
    "mode": "cfl",
    "cfl": 0.4,
    "dt_min": 1.0e-6,
    "dt_max": 0.0002,
    "steps": 5000
  },

  "export": {
    "csv": { "enable": false },
    "vtk": { "enable": false }
  }
}
