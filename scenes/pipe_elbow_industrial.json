{
  "meta": {
    "name": "3D Industrial Elbow — Re~36, Dean vortex regime",
    "version": 1,
    "dimensions": 3,
    "scene_type": "pipe_elbow_analytical",
    "description": "L-elbow dx=0.015, R=0.06m, nu=0.001 → Re~36 at quasi-steady. Above Dean threshold De_crit=11.6."
  },

  "fluid": {
    "type": "numpy_file",
    "file": "../assets/elbow_industrial/fluid.npy",
    "spacing": 0.015,
    "initial_velocity": [0.0, 0.0, 0.0]
  },

  "domain": {
    "min": [-0.05, -0.10, -0.15],
    "max": [0.45, 0.45, 0.15]
  },

  "material": {
    "rho0": 1000.0,
    "eos": { "type": "linear", "k": 50000.0 }
  },

  "solver": {
    "type": "dfsph",
    "eos_k": 50000.0,
    "density_diffusion": {
      "enable": true,
      "delta": 0.1,
      "floor_ratio": 0.97
    },
    "dfsph": {
      "viscosity_factor": 2.0,
      "eta_cd": 0.05,
      "eta_df": 0.1,
      "max_iter_cd": 10,
      "max_iter_df": 100,
      "free_surface_stabilization": { "enable": false }
    }
  },

  "forces": {
    "gravity": [0.003, 0.0, 0.0],
    "viscosity": { "enable": true, "nu": 0.05 },
    "xsph": { "enable": false }
  },

  "neighbors": {
    "type": "kdtree",
    "support_radius": 0.06
  },

  "time": {
    "mode": "cfl",
    "cfl": 0.4,
    "dt_min": 1.0e-6,
    "dt_max": 0.0005,
    "steps": 3000
  },

  "boundaries": [
    { "type": "numpy_file", "file": "../assets/elbow_industrial/boundary.npy" }
  ],

  "export": {
    "csv": { "enable": false },
    "vtk": { "enable": false }
  }
}
