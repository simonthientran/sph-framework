{
  "meta": {
    "name": "3D Industrial Elbow — Re~36, Dean vortex regime",
    "version": 1,
    "dimensions": 3,
    "scene_type": "pipe_elbow_analytical",
    "description": "Curved elbow: torus bend R_bend=1.5*D=0.135, r=0.045, dx=0.012, nu=0.03, tangent body force mag=2.0. Fluid+boundary share centerline (concentric wall). Smooth arc, round cross-section; Dean number De=Re*sqrt(r/R_bend) well-defined."
  },

  "fluid": {
    "type": "numpy_file",
    "file": "../assets/elbow_analytical/fluid.npy",
    "spacing": 0.012,
    "initial_velocity": [0.25, 0.0, 0.0]
  },

  "domain": {
    "min": [-0.05, 0.00, -0.12],
    "max": [0.56, 0.64, 0.12]
  },

  "material": {
    "rho0": 1000.0,
    "eos": { "type": "linear", "k": 50000.0 }
  },

  "solver": {
    "type": "dfsph",
    "eos_k": 50000.0,
    "density_diffusion": {
      "enable": true,
      "delta": 0.1,
      "floor_ratio": 0.97
    },
    "dfsph": {
      "viscosity_factor": 2.0,
      "eta_cd": 0.05,
      "eta_df": 0.1,
      "max_iter_cd": 10,
      "max_iter_df": 100,
      "free_surface_stabilization": { "enable": false }
    }
  },

  "forces": {
    "gravity": [0.0, 0.0, 0.0],
    "body_force_mode": "tangent",
    "body_force_magnitude": 2.0,
    "viscosity": { "enable": true, "nu": 0.03 },
    "xsph": { "enable": false }
  },

  "neighbors": {
    "type": "kdtree",
    "support_radius": 0.06
  },

  "time": {
    "mode": "cfl",
    "cfl": 0.4,
    "dt_min": 1.0e-6,
    "dt_max": 0.0005,
    "steps": 3000
  },

  "boundaries": [
    { "type": "numpy_file", "file": "../assets/elbow_analytical/boundary.npy" }
  ],

  "export": {
    "csv": { "enable": false },
    "vtk": { "enable": false }
  }
}
